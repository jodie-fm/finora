{
  "expo": {
    "name": "Glance",
    "slug": "glance",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#e3eae8",
    "primaryColor": "#10B981",
    "ios": {
      "userInterfaceStyle": "automatic",
      "supportsTablet": true,
      "bundleIdentifier": "eu.jbrunn.glance",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#E9FFF8"
      },
      "package": "eu.jbrunn.glance",
      "userInterfaceStyle": "automatic"
    },
    "web": {
      "favicon": "./src/assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#e3eae8",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-status-bar",
      [
        "expo-build-properties",
        { "android": { "usePrecompiledHeaders": true } }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "7eb97665-b80a-424c-83e2-ee9b15569992"
      }
    },
    "owner": "jodie"
  }
}
